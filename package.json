{
  "name": "dsh-fullscreen-settings",
  "displayName": "DSH Fullscreen Settings",
  "version": "0.1.6",
  "description": "把 DSH 的设置弹窗改成 Codex 风格整页全屏设置页 — Codex-style full-page settings for DeepSeek Harness.",
  "icon": "./icon.svg",
  "author": "Functy",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "settings",
    "ui",
    "fullscreen"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test tests/",
    "prepublishOnly": "node --test tests/"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/functy23/dsh-fullscreen-settings.git"
  },
  "homepage": "https://github.com/functy23/dsh-fullscreen-settings#readme",
  "bugs": "https://github.com/functy23/dsh-fullscreen-settings/issues",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
